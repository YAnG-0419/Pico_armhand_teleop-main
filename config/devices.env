# Site-level device identities. Exporting a variable before launch overrides
# its tracked default, so replacing a PICO tracker does not require code edits.
PICO_LEFT_TRACKER_SERIAL="${PICO_LEFT_TRACKER_SERIAL:-PC2310MLL5060501G}"
PICO_RIGHT_TRACKER_SERIAL="${PICO_RIGHT_TRACKER_SERIAL:-PC2310MLL5290914G}"

# Confirmed Wuji Hand 2 hardware endpoints for this workcell.
WUJI_LEFT_ADDRESS="${WUJI_LEFT_ADDRESS:-192.168.1.110:7447}"
WUJI_RIGHT_ADDRESS="${WUJI_RIGHT_ADDRESS:-192.168.2.111:7447}"

export PICO_LEFT_TRACKER_SERIAL PICO_RIGHT_TRACKER_SERIAL
export WUJI_LEFT_ADDRESS WUJI_RIGHT_ADDRESS
