 #include <cassert>
 #include <mutex>
+#include <pthread.h>
+#include <system_error>

 #include <franka/control_tools.h>
 #include <franka/rate_limiting.h>
@@ -33,6 +35,15 @@ Robot::Robot(std::unique_ptr<franka::Robot> robot, std::unique_ptr<Model> model)
     : robot_(std::move(robot)), franka_hardware_model_(std::move(model)) {}

 Robot::Robot(const std::string& robot_ip, const rclcpp::Logger& logger) {
+  int original_policy = 0;
+  sched_param original_parameters{};
+  const int get_scheduler_result =
+      pthread_getschedparam(pthread_self(), &original_policy, &original_parameters);
+  if (get_scheduler_result != 0) {
+    throw std::system_error(get_scheduler_result, std::generic_category(),
