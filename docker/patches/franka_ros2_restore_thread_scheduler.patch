                 "installation_linux.html#setting-up-the-real-time-kernel\n");
   }
   robot_ = std::make_unique<franka::Robot>(robot_ip, rt_config);
+  const int restore_scheduler_result =
+      pthread_setschedparam(pthread_self(), original_policy, &original_parameters);
+  if (restore_scheduler_result != 0) {
+    throw std::system_error(restore_scheduler_result, std::generic_category(),
+                            "Could not restore the ROS thread scheduling policy");
